<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.line.stock.popup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='sale_management']" position="inside">
                <h2>Order Line Stock Popup</h2>
                <div class="row mt16 o_settings_container" name="sale_line_stock_popup_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="sale_stock_popup_setting">
                        <div class="o_setting_left_pane">
                            <field name="sale_stock_popup_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="sale_stock_popup_enabled"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific."/>
                            <div class="text-muted">
                                Show On Hand / Forecasted columns on sales order lines and a stock card when hovering the line product.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('sale_stock_popup_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label for="sale_stock_popup_metric" string="Metric" class="col-lg-4 o_light_label"/>
                                    <field name="sale_stock_popup_metric" widget="radio" class="col-lg-8"
                                           attrs="{'required': [('sale_stock_popup_enabled', '=', True)]}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="sale_stock_popup_scope" string="Scope" class="col-lg-4 o_light_label"/>
                                    <field name="sale_stock_popup_scope" widget="radio" class="col-lg-8"
                                           attrs="{'required': [('sale_stock_popup_enabled', '=', True)]}"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-12 d-flex align-items-center">
                                        <field name="sale_stock_popup_global_active" class="me-2"/>
                                        <label for="sale_stock_popup_global_active" class="o_light_label"/>
                                    </div>
                                    <div class="col-12 text-muted">
                                        Master switch for the whole database: turn off to pause the popup for every company.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
