<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.line.stock.popup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Order Line Stock Popup" name="sale_line_stock_popup_container">
                    <setting id="sale_stock_popup_setting" company_dependent="1"
                             help="Show On Hand / Forecasted columns on sales order lines and a stock card when hovering the line product.">
                        <field name="sale_stock_popup_enabled"/>
                        <div class="content-group" invisible="not sale_stock_popup_enabled">
                            <div class="row mt16">
                                <label for="sale_stock_popup_metric" string="Metric" class="col-lg-4 o_light_label"/>
                                <field name="sale_stock_popup_metric" widget="radio" class="col-lg-8"
                                       required="sale_stock_popup_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="sale_stock_popup_scope" string="Scope" class="col-lg-4 o_light_label"/>
                                <field name="sale_stock_popup_scope" widget="radio" class="col-lg-8"
                                       required="sale_stock_popup_enabled"/>
                            </div>
                            <div class="row mt8">
                                <div class="col-12 d-flex align-items-center">
                                    <field name="sale_stock_popup_global_active" class="w-auto me-2"/>
                                    <label for="sale_stock_popup_global_active" class="o_light_label"/>
                                </div>
                                <div class="col-12 text-muted">
                                    Master switch for the whole database: turn off to pause the popup for every company.
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
