<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo data used for the apps.odoo.com screenshots:
         two warehouses, three storable products with stock spread over
         locations, an outgoing confirmed order, an incoming receipt and a
         quotation to hover. -->

    <record id="base.main_company" model="res.company">
        <field name="sale_stock_popup_enabled" eval="True"/>
        <field name="sale_stock_popup_metric">both</field>
        <field name="sale_stock_popup_scope">all_warehouses</field>
    </record>

    <!-- Warehouses -->
    <record id="demo_wh_jeddah" model="stock.warehouse">
        <field name="name">Jeddah Warehouse</field>
        <field name="code">JED</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_loc_wh_shelf_a" model="stock.location">
        <field name="name">Shelf A</field>
        <field name="usage">internal</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_loc_wh_shelf_b" model="stock.location">
        <field name="name">Shelf B</field>
        <field name="usage">internal</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>

    <!-- Products -->
    <record id="demo_product_chair" model="product.product">
        <field name="name">Ergo Pro Office Chair</field>
        <field name="default_code">SLSP-CHAIR</field>
        <field name="type">product</field>
        <field name="list_price">1250.0</field>
        <field name="standard_price">780.0</field>
        <field name="image_1920" type="base64" file="sale_line_stock_popup/static/img/demo_office_chair.png"/>
    </record>
    <record id="demo_product_desk" model="product.product">
        <field name="name">Standing Desk 160 cm</field>
        <field name="default_code">SLSP-DESK</field>
        <field name="type">product</field>
        <field name="list_price">2400.0</field>
        <field name="standard_price">1650.0</field>
        <field name="image_1920" type="base64" file="sale_line_stock_popup/static/img/demo_standing_desk.png"/>
    </record>
    <record id="demo_product_lamp" model="product.product">
        <field name="name">LED Desk Lamp</field>
        <field name="default_code">SLSP-LAMP</field>
        <field name="type">product</field>
        <field name="list_price">185.0</field>
        <field name="standard_price">92.5</field>
        <field name="image_1920" type="base64" file="sale_line_stock_popup/static/img/demo_desk_lamp.png"/>
    </record>

    <!-- On hand quantities -->
    <record id="demo_quant_chair_stock" model="stock.quant">
        <field name="product_id" ref="demo_product_chair"/>
        <field name="inventory_quantity">18.0</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_chair_shelf_a" model="stock.quant">
        <field name="product_id" ref="demo_product_chair"/>
        <field name="inventory_quantity">6.0</field>
        <field name="location_id" ref="demo_loc_wh_shelf_a"/>
    </record>
    <record id="demo_quant_chair_jed" model="stock.quant">
        <field name="product_id" ref="demo_product_chair"/>
        <field name="inventory_quantity">11.0</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('sale_line_stock_popup.demo_wh_jeddah').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_desk_shelf_b" model="stock.quant">
        <field name="product_id" ref="demo_product_desk"/>
        <field name="inventory_quantity">4.0</field>
        <field name="location_id" ref="demo_loc_wh_shelf_b"/>
    </record>
    <record id="demo_quant_lamp_stock" model="stock.quant">
        <field name="product_id" ref="demo_product_lamp"/>
        <field name="inventory_quantity">42.0</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_lamp_jed" model="stock.quant">
        <field name="product_id" ref="demo_product_lamp"/>
        <field name="inventory_quantity">25.0</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('sale_line_stock_popup.demo_wh_jeddah').lot_stock_id.id"/>
    </record>

    <function model="stock.quant" name="action_apply_inventory">
        <function eval="[[('id', 'in', (
            ref('demo_quant_chair_stock'), ref('demo_quant_chair_shelf_a'), ref('demo_quant_chair_jed'),
            ref('demo_quant_desk_shelf_b'), ref('demo_quant_lamp_stock'), ref('demo_quant_lamp_jed')))]]"
                  model="stock.quant" name="search"/>
    </function>

    <!-- Outgoing: a confirmed order reserves chairs and desks (forecast goes down,
         the desk goes negative to show the red figure) -->
    <record id="demo_so_confirmed" model="sale.order">
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
    </record>
    <record id="demo_so_confirmed_line_chair" model="sale.order.line">
        <field name="order_id" ref="demo_so_confirmed"/>
        <field name="product_id" ref="demo_product_chair"/>
        <field name="product_uom_qty">10.0</field>
    </record>
    <record id="demo_so_confirmed_line_desk" model="sale.order.line">
        <field name="order_id" ref="demo_so_confirmed"/>
        <field name="product_id" ref="demo_product_desk"/>
        <field name="product_uom_qty">6.0</field>
    </record>
    <function model="sale.order" name="action_confirm" eval="[[ref('demo_so_confirmed')]]"/>

    <!-- Incoming: a receipt of desks to Jeddah -->
    <record id="demo_receipt_jeddah" model="stock.picking">
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="picking_type_id" model="stock.picking.type" eval="obj().env.ref('sale_line_stock_popup.demo_wh_jeddah').in_type_id.id"/>
        <field name="location_id" ref="stock.stock_location_suppliers"/>
        <field name="location_dest_id" model="stock.location" eval="obj().env.ref('sale_line_stock_popup.demo_wh_jeddah').lot_stock_id.id"/>
    </record>
    <record id="demo_receipt_jeddah_move" model="stock.move">
        <field name="name">Standing Desk 160 cm</field>
        <field name="picking_id" ref="demo_receipt_jeddah"/>
        <field name="product_id" ref="demo_product_desk"/>
        <field name="product_uom" ref="uom.product_uom_unit"/>
        <field name="product_uom_qty">12.0</field>
        <field name="location_id" ref="stock.stock_location_suppliers"/>
        <field name="location_dest_id" model="stock.location" eval="obj().env.ref('sale_line_stock_popup.demo_wh_jeddah').lot_stock_id.id"/>
    </record>
    <function model="stock.picking" name="action_confirm" eval="[[ref('demo_receipt_jeddah')]]"/>

    <!-- Quotation used in the screenshots -->
    <record id="demo_so_quotation" model="sale.order">
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
    </record>
    <record id="demo_so_quotation_line_chair" model="sale.order.line">
        <field name="order_id" ref="demo_so_quotation"/>
        <field name="product_id" ref="demo_product_chair"/>
        <field name="product_uom_qty">8.0</field>
    </record>
    <record id="demo_so_quotation_line_desk" model="sale.order.line">
        <field name="order_id" ref="demo_so_quotation"/>
        <field name="product_id" ref="demo_product_desk"/>
        <field name="product_uom_qty">3.0</field>
    </record>
    <record id="demo_so_quotation_line_lamp" model="sale.order.line">
        <field name="order_id" ref="demo_so_quotation"/>
        <field name="product_id" ref="demo_product_lamp"/>
        <field name="product_uom_qty">15.0</field>
    </record>
</odoo>
